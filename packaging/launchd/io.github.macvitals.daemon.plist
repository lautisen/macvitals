<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.github.macvitals.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Application Support/MacVitals/MacVitals.app/Contents/MacOS/macvitals</string>
        <string>daemon</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Restart after crashes, but not after a clean exit (session finished). -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>60</integer>
    <!-- Lets the self-removal script outlive the daemon that launched it. -->
    <key>AbandonProcessGroup</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>Nice</key>
    <integer>10</integer>
    <key>LowPriorityIO</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Library/Logs/MacVitals.log</string>
    <key>StandardErrorPath</key>
    <string>/Library/Logs/MacVitals.log</string>
</dict>
</plist>
